# LINE Hub API — คัดลอกเป็น .env แล้วกรอก (ห้าม commit)
PORT=4100
# prisma = ฐานข้อมูลจริง (MariaDB) · memory = ทดลองในเครื่อง ข้อมูลหายเมื่อรีสตาร์ท
HUB_STORE=prisma
DATABASE_URL=mysql://hub:CHANGE_ME@localhost:3306/line_hub

# Messaging API ของ OA SJ-Webapp/Demo (Provider DemoWeb)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ที่ LIFF ของ Hub อยู่ (DemoWebsite = 2010195603) — ใช้ตรวจ ID token
HUB_LINE_LOGIN_CHANNEL_ID=2010195603
# LIFF ID ของหน้า "ยืนยันตัวตนพนักงาน" (สร้างใน DemoWebsite, Endpoint URL = https://hub.wonghiran.com/verify)
HUB_VERIFY_LIFF_ID=

# true = ใส่รหัสผ่านถูกแล้วยังต้องให้ superadmin กดอนุมัติอีกชั้น (ค่าเริ่มต้น false: การออกรหัสให้คืออนุมัติ)
HUB_REQUIRE_APPROVAL=false

# โทเค็นกลางสำหรับสคริปต์/ฉุกเฉิน (ทางหลักคือ superadmin ล็อกอินด้วย LINE) — สุ่มยาวๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_ADMIN_TOKEN=
# origin ที่เรียก /api/me ได้ (เฟส 3: ALL APP) คั่นด้วยจุลภาค
HUB_CORS_ORIGINS=
